# 복사해서 config.env로 쓰세요 (config.env는 git에 올리지 않습니다)
# 업무시간 (KST, HHMM, 양끝 포함). 월~금만, holidays_kr.txt의 날짜는 쉽니다.
WORK_AGENT_START=0900
WORK_AGENT_END=1800
# 모델 별칭 (사용량을 줄이려면 haiku, 판단 품질이 먼저면 sonnet)
WORK_AGENT_MODEL=sonnet
# 감시 대상 (쉼표로 구분). 비워 두면 DM·멘션만 봅니다.
WORK_AGENT_CHANNELS=
WORK_AGENT_KEYWORDS="요청,확인 부탁,회신"
# 에이전트가 쓸 수 있는 도구(읽기 전용). claude.ai 커넥터는 mcp__claude_ai_<커넥터>__<도구> 형식입니다(맥미니에서 확인).
WORK_AGENT_ALLOWED_TOOLS="mcp__claude_ai_Slack__slack_search_public_and_private mcp__claude_ai_Slack__slack_read_channel mcp__claude_ai_Slack__slack_read_thread mcp__claude_ai_Slack__slack_search_channels mcp__claude_ai_Slack__slack_search_users mcp__claude_ai_Slack__slack_read_user_profile mcp__claude_ai_Plaud__get_current_user mcp__claude_ai_Plaud__list_files mcp__claude_ai_Plaud__get_file mcp__claude_ai_Plaud__get_note mcp__claude_ai_Plaud__get_transcript"
# 명시적으로 막을 도구 (서버 이름만 쓰면 그 서버의 도구 전체를 막습니다)
WORK_AGENT_DISALLOWED_TOOLS="Bash Write Edit NotebookEdit WebFetch WebSearch mcp__claude_ai_Slack__slack_send_message mcp__claude_ai_Slack__slack_send_message_draft mcp__claude_ai_Slack__slack_schedule_message mcp__claude_ai_Slack__slack_add_reaction mcp__claude_ai_Slack__slack_create_canvas mcp__claude_ai_Slack__slack_update_canvas mcp__claude_ai_Slack__slack_create_conversation mcp__claude_ai_Slack__slack_create_list mcp__claude_ai_Slack__slack_update_list mcp__claude_ai_Slack__slack_add_list_record mcp__claude_ai_Slack__slack_update_list_record mcp__claude_ai_Slack__slack_get_file_upload_url mcp__claude_ai_Slack__slack_complete_file_upload mcp__claude_ai_Gmail mcp__claude_ai_Google_Calendar mcp__claude_ai_Google_Drive mcp__claude_ai_Notion mcp__claude_ai_Claude_Docs"
# claude 실행 파일 경로 (launchd는 PATH가 짧으므로 `which claude` 결과를 적으세요)
# CLAUDE_BIN=/Users/<you>/.local/bin/claude
# 특이사항(긴급 건, 연속 3회 실패, Pixel Agents 반복 종료) 슬랙 DM 받을 사용자 ID. 비우면 DM을 보내지 않습니다.
WORK_AGENT_SLACK_DM_USER=
WORK_AGENT_DM_MODEL=haiku
WORK_AGENT_DM_DAILY_MAX=10
# 2단계(2a) 슬랙 답장 초안: 1이면 답이 필요한 슬랙 요청의 원래 스레드에 "보내지 않은 초안"을 넣어 둡니다.
# 대표님이 슬랙에서 확인하고 직접 전송합니다. 에이전트는 아무것도 보내지 않습니다. 기본은 꺼짐(0).
WORK_AGENT_SLACK_DRAFTS=0
WORK_AGENT_DRAFT_TOOL=mcp__claude_ai_Slack__slack_send_message_draft
WORK_AGENT_DRAFT_MODEL=haiku
WORK_AGENT_DRAFT_DAILY_MAX=20
WORK_AGENT_DRAFT_RUN_MAX=5
# 초안 1건당 claude 실행 제한 시간(초)
WORK_AGENT_DRAFT_TIMEOUT=150
# 3단계 사무실: 1이면 매 폴링 끝에 직원 실행·전광판 결재 반영·상태 보고를 합니다. 기본 꺼짐(0).
WORK_AGENT_OFFICE=0
# 전광판(claude.ai 아티팩트) 주소. 비우면 사무실이 돌지 않습니다.
WORK_AGENT_BOARD_URL=https://claude.ai/artifact/LmPoyPTAQ7McLikkoYEhe8
# 커넥터 도구 이름 앞부분 (맥미니는 mcp__claude_ai_, 클라우드 세션은 mcp__)
WORK_AGENT_MCP_PREFIX=mcp__claude_ai_
# 고정 호출(전광판 읽기·쓰기, 캘린더 등록)에 쓰는 모델·제한 시간
WORK_AGENT_OFFICE_MODEL=haiku
WORK_AGENT_OFFICE_TIMEOUT=150
# 직원 실행 제한 시간(초), 승인 실행 하루 상한, 결재 건 만료(시간)
WORK_AGENT_STAFF_TIMEOUT=600
WORK_AGENT_EXEC_DAILY_MAX=10
WORK_AGENT_PROPOSAL_TTL_HOURS=48
# 원가 담당: 검사할 MASTER 형식 원가표(시즌 사본)와 시즌 기획 파일. "시즌=원가표ID[,기획파일ID]"를 공백으로 여러 개.
# 파일 ID는 이 파일(로컬, git 제외)에만 적습니다. 비우면 원가 담당은 "자료 설정 없음"으로 멈춥니다.
WORK_AGENT_COST_SOURCES=
# 원가표를 받는 Drive 도구(맥미니 커넥터 이름이 다르면 바꾸세요)
# WORK_AGENT_DRIVE_DOWNLOAD_TOOL=mcp__claude_ai_Google_Drive__download_file_content
# Pixel Agents (업무시간에 127.0.0.1에서만 실행, 18:15 종료)
PIXEL_AGENTS_PORT=17777
PIXEL_AGENTS_END=1815
