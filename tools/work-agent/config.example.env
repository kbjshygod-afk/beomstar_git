# 복사해서 config.env로 쓰세요 (config.env는 git에 올리지 않습니다)
# 업무시간 (KST, HHMM). 일요일은 쉽니다.
WORK_AGENT_START=0830
WORK_AGENT_END=1900
# 모델 별칭 (사용량을 줄이려면 haiku, 판단 품질이 먼저면 sonnet)
WORK_AGENT_MODEL=sonnet
# 감시 대상 (쉼표로 구분). 비워 두면 DM·멘션만 봅니다.
WORK_AGENT_CHANNELS=
WORK_AGENT_KEYWORDS=요청,확인 부탁,회신
# 에이전트가 쓸 수 있는 도구(읽기 전용). 도구 이름은 맥미니의 `claude` 안에서 /mcp 로 확인해 맞추세요.
WORK_AGENT_ALLOWED_TOOLS="mcp__Slack__slack_search_public_and_private mcp__Slack__slack_read_channel mcp__Slack__slack_read_thread mcp__Slack__slack_search_channels mcp__Slack__slack_search_users mcp__Slack__slack_read_user_profile mcp__Plaud__get_current_user mcp__Plaud__list_files mcp__Plaud__get_note mcp__Plaud__get_transcript"
# 명시적으로 막을 도구
WORK_AGENT_DISALLOWED_TOOLS="Bash Write Edit NotebookEdit WebFetch WebSearch mcp__Slack__slack_send_message mcp__Slack__slack_send_message_draft mcp__Slack__slack_schedule_message mcp__Gmail__send_message mcp__Gmail__reply mcp__Gmail__forward mcp__Google_Calendar__create_event mcp__Google_Calendar__update_event mcp__Google_Calendar__delete_event"
